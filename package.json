{
  "name": "meeting-cost-cli",
  "version": "1.0.0",
  "description": "CLI que calcula o custo total de mão de obra de uma reunião.",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "meeting-cost": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/node": "24.13.3",
    "typescript": "5.9.3"
  }
}
